#!/bin/bash -e

# ---------------------------------------------------------
# Print all environment variables, one per line
# ---------------------------------------------------------
# echo "===== Environment Variables ====="
# env | sort
# echo "=================================="

# save the environment to be able to restore it in the FCGI daemon (used
# in /usr/local/bin/qgis_mapsev_wrapper) for the startup code.
${GET_ENV} | sed -e 's/^\([^=]*\)=.*/PassEnv \1/' > /tmp/pass-env

# Save the environment to be able to restore it in the FCGI daemon (used in /usr/local/bin/mapserv_wrapper)
${GET_ENV} | sed -e 's/.\+/export "\0"/' > /tmp/init_env

# Define the local directory used by MapServer.
LOCAL_DIR="/etc/mapserver"
SMOKE_TEST_MODE="${SMOKE_TEST:-0}"
MAP_TEMP_DIR="${MAPSCRIPT_TEMP_MAP_DIR:-/etc/mapserver/maps}"
WORKSPACE_ROOT="${MAPSERVER_WORKSPACE_ROOT:-/workspaces/fim-docker/CHAINGUARD/MAPSERVER}"
MAP_DEPLOY_ENV="${MAP_DEPLOY_ENV:-${MAP_ENV:-${FIM_ENV:-dev}}}"
MAP_RENDERED_BASE="${MAP_RENDERED_BASE:-${WORKSPACE_ROOT}/map_testing/rendered}"
USE_RENDERED_MAPS="${USE_RENDERED_MAPS:-1}"

# Create the local directory if it doesn't exist.
mkdir -p "${LOCAL_DIR}"

if [ "${SMOKE_TEST_MODE}" = "1" ] || [ "${SMOKE_TEST_MODE}" = "true" ] || [ "${SMOKE_TEST_MODE}" = "TRUE" ]; then
  echo "SMOKE_TEST=${SMOKE_TEST_MODE}: skipping AWS sync and AWS-generated include files"
else
  # Define the S3 bucket and folder path.
  S3_BUCKET="s3://${AWS_S3_BUCKET:-}"
  S3_FOLDER="${AWS_DIR:-}"
  AWS_PROFILE_ARG=()

  if [ -n "${AWS_PROFILE:-}" ]; then
    AWS_PROFILE_ARG=(--profile="${AWS_PROFILE}")
  fi

  if [ -n "${AWS_SESSION_TOKEN}" ]; then
      export AWS_ACCESS_KEY_ID=$(echo -n "${AWS_ACCESS_KEY_ID}" | tr -d '\r\n ')
      export AWS_SECRET_ACCESS_KEY=$(echo -n "${AWS_SECRET_ACCESS_KEY}" | tr -d '\r\n ')
      export AWS_SESSION_TOKEN=$(echo -n "${AWS_SESSION_TOKEN}" | tr -d '\r\n ')
  fi
  
  if [ -n "${AWS_S3_BUCKET:-}" ] && [ -n "${AWS_DIR:-}" ]; then
    # Download the folder from S3.
    echo "Downloading ${S3_BUCKET}/${S3_FOLDER} to ${LOCAL_DIR}"
    aws s3 sync "${S3_BUCKET}/${S3_FOLDER}" "${LOCAL_DIR}" "${AWS_PROFILE_ARG[@]}" 
  else
    echo "AWS_S3_BUCKET or AWS_DIR not set; skipping AWS sync"
  fi

  # Create include files based on fim_* environment variables.
  ${GET_ENV} | grep -i '^fim_' | sed -e 's/^[Ff][Ii][Mm]_\(.*\)=\(.*\)$/config \1 "\2"/' > /etc/mapserver/include/aws.inc || true
fi

# If rendered map_testing output exists, prefer it over downloaded maps.
RENDERED_ENV_MAP_DIR="${MAP_RENDERED_BASE}/${MAP_DEPLOY_ENV}/maps"
if [ "${USE_RENDERED_MAPS}" = "1" ] || [ "${USE_RENDERED_MAPS}" = "true" ] || [ "${USE_RENDERED_MAPS}" = "TRUE" ]; then
  if [ -d "${RENDERED_ENV_MAP_DIR}" ]; then
    echo "Using rendered maps from ${RENDERED_ENV_MAP_DIR}"
    mkdir -p "${LOCAL_DIR}/maps"
    rm -rf "${LOCAL_DIR}/maps/layers"
    find "${LOCAL_DIR}/maps" -maxdepth 1 -type f -name '*.map' -delete || true
    cp -R "${RENDERED_ENV_MAP_DIR}"/. "${LOCAL_DIR}/maps/"
  else
    echo "Rendered maps not found at ${RENDERED_ENV_MAP_DIR}; using existing ${LOCAL_DIR}/maps"
  fi
fi

# AWS sync can reset directory metadata. Enforce writable temp-map dir after sync.
if [ -d "${MAP_TEMP_DIR}" ]; then
  chmod 777 "${MAP_TEMP_DIR}" || true
fi

# Keep log permissions consistent for local smoke tests.
LOG_DIR="${LOCAL_DIR}/logs"
if [ -d "${LOG_DIR}" ]; then
  echo "Setting permissions to 777 for all .log files in ${LOG_DIR}"
  for file in "${LOG_DIR}"/*.log; do
    [ -e "$file" ] || continue  # Skip if no .log files exist
    chmod 777 "$file"
  done
else
  echo "Log directory ${LOG_DIR} does not exist."
fi

# Update Include files
PREFIXES=("DB_ADMIN" "DB_PUBLIC" "DB_SIMDAMS")
for PREFIX in "${PREFIXES[@]}"; do
  SUFFIX="${PREFIX#*_}"
  LOWERCASE_SUFFIX=$(echo "$SUFFIX" | tr '[:upper:]' '[:lower:]')
  echo "$PREFIX -> $LOWERCASE_SUFFIX"

  INPUT_FILE="/etc/mapserver/include/${LOWERCASE_SUFFIX}.inc"
  TEMP_FILE="$(mktemp)"

  while IFS='=' read -r VAR_NAME VAR_VALUE; do
    if [[ $VAR_NAME =~ ^DB_ ]]; then
      sed -i "s|\${${VAR_NAME}}|${VAR_VALUE}|g" "$INPUT_FILE"
    fi
  done < <(env)
done

# if [ "${UID}" == 0 ]; then
#     echo "Switching listen port to 80"
#     cd /tmp
#     sed -i -e 's/<VirtualHost \*:8080>/<VirtualHost *:80>/' /etc/apache2/sites-available/000-default.conf
#     sed -i -e 's/Listen 8080$/Listen 80/' /etc/apache2/ports.conf
# fi

trap '' WINCH

rm -f "${APACHE_PID_FILE}"

exec httpd -DFOREGROUND
